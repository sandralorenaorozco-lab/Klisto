# =====================================================================
# Klisto · Variables de entorno
# Copia este archivo como ".env.local" y llena los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# =====================================================================

# --- Supabase (obligatorio) ------------------------------------------
# Supabase → tu proyecto → Project Settings → API Keys / Data API
# URL del proyecto, ej. https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública ("Publishable key", empieza por sb_publishable_…).
# También sirve la clave antigua "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta ("Secret key", empieza por sb_secret_…). También sirve la
# antigua "service_role". SOLO servidor: salta la seguridad RLS, no la compartas.
SUPABASE_SECRET_KEY=

# --- Sitio ------------------------------------------------------------
# Dirección pública del sitio, sin "/" al final. Se usa en el QR y en los
# enlaces de seguimiento que se envían por WhatsApp.
# En local: http://localhost:3000 · En producción: https://klisto.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp Business Cloud API (opcional) ---------------------------
# Si las dejas vacías, Klisto funciona en "modo simulado": los mensajes se
# muestran en la consola y se guardan en la tabla notifications_log.
# Meta for Developers → tu app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=es_CO
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=pedido_confirmado
WHATSAPP_TEMPLATE_ORDER_READY=pedido_listo

# --- Datos de prueba (solo para "npm run seed") -----------------------
# Usuario dueño del restaurante demo (Klisto Burger, /demo)
SEED_DEMO_OWNER_EMAIL=demo@klisto.co
SEED_DEMO_OWNER_PASSWORD=KlistoDemo2026
# Tu usuario de superadministrador (/admin). Usa una contraseña fuerte.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Pagos en línea con Wompi (próximamente, aún no se usan) ---------
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=
